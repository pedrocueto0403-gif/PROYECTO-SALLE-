{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "proyecto/**",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/public/(.+\\.(?:css|js|map|png|jpe?g|gif|svg|webp|ico|bmp|woff2?|ttf|otf|eot|pdf|txt))",
      "dest": "/proyecto/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
